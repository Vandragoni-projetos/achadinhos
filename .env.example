# ACHADINHOS — variáveis de ambiente (Docker / EasyPanel)
# Copie para .env em ambiente LOCAL, ou cadastre estes valores em
# EasyPanel > App > Environment. NÃO comitar .env com valores reais.
#
# Se NENHUMA destas variáveis for definida, a aplicação usa os valores
# originais de hospedagem tradicional (localhost / achadinhos / root / sem senha).

# Host do serviço de banco. No EasyPanel costuma ser o nome do serviço MariaDB
# (ex.: "achadinhos-db") ou "<projeto>_<servico>".
DB_HOST=achadinhos-db

# Porta do MariaDB (padrão 3306).
DB_PORT=3306

# Nome do banco onde o "Banco de Dados.sql" será importado.
DB_NAME=achadinhos

# Utilizador do banco (precisa de privilégios DDL — ver DEPLOY-EASYPANEL.md).
DB_USER=achadinhos

# Senha do utilizador do banco.
DB_PASSWORD=
