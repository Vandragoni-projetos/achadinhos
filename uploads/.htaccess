# Impede a EXECUÇÃO de qualquer script nesta pasta (conteúdo enviado pelo utilizador).
# Não altera a lógica de upload da aplicação — imagens (.jpg .jpeg .png .gif .webp .ico)
# continuam a ser servidas normalmente.

<FilesMatch "(?i)\.(php|phtml|phar|pht|phps|php[0-9]|cgi|pl|py|rb|asp|aspx|jsp|sh|htaccess|htpasswd)$">
    Require all denied
</FilesMatch>

Options -ExecCGI -Indexes -MultiViews
RemoveHandler .php .phtml .phar .pht .php3 .php4 .php5 .php7 .php8
RemoveType .php .phtml .phar .pht
